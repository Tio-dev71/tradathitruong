# Cổng chạy ứng dụng (Mặc định 3888 cho Mac Mini M1 Server)
PORT=3888

# Môi trường chạy (development | production)
NODE_ENV=production

# Tên miền chính thức
APP_DOMAIN=tradathitruong.io.vn
APP_URL=https://tradathitruong.io.vn

# Token bảo mật truy cập trang quản trị Admin Dashboard (/api/admin)
ADMIN_TOKEN=admin-tra-da-2026

# Khóa bí mật dùng để xác thực HMAC-SHA256 cho Webhook Signals (/api/webhooks/signals)
WEBHOOK_SECRET=tra-da-thi-truong-secret-key-2026

# Khóa bí mật API Plisio (Lấy tại: https://plisio.net/account/api)
# Tỷ giá quy ước: 5 USDT = 100 Xu
PLISIO_API_KEY=
